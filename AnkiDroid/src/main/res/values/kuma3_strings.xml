    <string name="kuma3_pref_leaderboard_signed_in">Signed in as %s. Off hides the board and stops the uploads; the sign-in is kept.</string>
    <string name="kuma3_pref_leaderboard_signed_out">The Anki Leaderboard add-on\'s board (an unofficial client of its server). Sign in from the deck list menu.</string>
    <string name="kuma3_pref_lofi" maxLength="41">Lofi button</string>
    <string name="kuma3_pref_lofi_summary">Lofi music while you study: tap the headphones in the deck list or the reviewer, long-press for tracks, volume and sources</string>
    <string name="kuma3_pref_rwkv_forecast" maxLength="41">RWKV forecast</string>
    <string name="kuma3_pref_rwkv_forecast_summary">Under \'Studied today\': review cards due, added by the daily minimum, near the line and safe now, and how many more become due in 1 h, 3 h and by tomorrow. Not shown above 3000 review cards (too slow)</string>
    <string name="kuma3_pref_rwkv_forecast_graph" maxLength="41">RWKV forecast graph</string>
    <string name="kuma3_pref_rwkv_forecast_graph_summary">Below the heatmap: a dot per review card at its recall now, coloured like the forecast\'s counts. Not shown above 3000 review cards either</string>
    <string name="kuma3_pref_rwkv_toast" maxLength="41">\'Rebuilding RWKV\' message</string>
    <string name="kuma3_pref_rwkv_toast_summary">Shown when the RWKV state is rebuilt (first start, after an update), and a notification when it is ready</string>
    <string name="kuma3_pref_rwkv_model" maxLength="41">RWKV model</string>
    <string name="kuma3_pref_rwkv_model_summary">%s. This choice is local; the desktop fork defaults to Small. Big is its legacy model. Small is JSchoreels\' 331k-parameter SM72 model, also used by the newer desktop fork. Changing models rebuilds the RWKV state from the review history</string>
    <string name="kuma3_pref_rwkv_precision" maxLength="41">RWKV state precision</string>
    <string name="kuma3_pref_rwkv_precision_summary">%s. This choice is local; the desktop fork defaults to int4 cards / int8 notes. int8 uses about a third of f32\'s memory with the same accuracy; int4 cards / int8 notes a quarter less than int8, slightly less accurate. A change rebuilds the RWKV state from the review history</string>
    <string-array name="kuma3_rwkv_model_labels">
        <item>Big (2.8M parameters, default)</item>
        <item>Small (331k parameters, less memory)</item>
    </string-array>
    <string-array name="kuma3_rwkv_precision_labels">
        <item>int8 (default)</item>
        <item>f32 (full precision)</item>
        <item>int4 cards, int8 notes (less memory)</item>
    </string-array>
